#!/usr/bin/env bash
set -euo pipefail

PROGRAM="${0##*/}"
CODEX_APP="${CODEX_APP:-/Applications/Codex.app}"
CODEX_APP_BIN="${CODEX_APP_BIN:-$CODEX_APP/Contents/MacOS/Codex}"
CODEX_BUNDLED_CLI="${CODEX_BUNDLED_CLI:-$CODEX_APP/Contents/Resources/codex}"
CODEX_PROFILE_QUIT_ATTEMPTS="${CODEX_PROFILE_QUIT_ATTEMPTS:-30}"
CODEX_PROFILE_QUIT_SLEEP="${CODEX_PROFILE_QUIT_SLEEP:-0.5}"

usage() {
  cat <<EOF
$PROGRAM - run Codex with isolated CODEX_HOME profiles

Usage:
  $PROGRAM app <profile> [workspace]
  $PROGRAM cli <profile> [codex-args...]
  $PROGRAM login <profile> [codex-login-args...]
  $PROGRAM status [profile]
  $PROGRAM list
  $PROGRAM path <profile>
  $PROGRAM doctor

Examples:
  $PROGRAM login 1
  $PROGRAM app 1 ~/Dev/my-project
  $PROGRAM cli 3 exec "review this repo"
  $PROGRAM list
  $PROGRAM status

Profiles map to:
  default, dev, main  -> ~/.codex
  any other name       -> ~/.codex-<profile>

Environment:
  CODEX_APP       Override Codex.app path.
  CODEX_APP_BIN   Override Codex Desktop binary path.
  CODEX_CLI       Override Codex CLI binary path.
EOF
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

validate_profile() {
  local profile="$1"
  if [[ ! "$profile" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    die "Invalid profile '$profile'. Use letters, numbers, dots, dashes, or underscores."
  fi
}

codex_home_for_profile() {
  local profile="$1"
  validate_profile "$profile"
  case "$profile" in
    default | dev | main)
      printf '%s/.codex\n' "$HOME"
      ;;
    *)
      printf '%s/.codex-%s\n' "$HOME" "$profile"
      ;;
  esac
}

ensure_home() {
  local codex_home="$1"
  mkdir -p "$codex_home" || die "Cannot create directory: $codex_home"
  [[ -d "$codex_home" ]] || die "Not a directory: $codex_home"
  chmod 700 "$codex_home" || die "Cannot set private permissions on: $codex_home"
}

codex_desktop_running() {
  pgrep -x Codex > /dev/null 2>&1 && return 0
  pgrep -f "$CODEX_BUNDLED_CLI app-server" > /dev/null 2>&1 && return 0
  return 1
}

find_codex_cli() {
  if [[ -n "${CODEX_CLI:-}" ]]; then
    [[ -x "$CODEX_CLI" ]] || die "CODEX_CLI is set but not executable: $CODEX_CLI"
    printf '%s\n' "$CODEX_CLI"
    return 0
  fi
  if command -v codex > /dev/null 2>&1; then
    command -v codex
    return 0
  fi
  if [[ -x "$CODEX_BUNDLED_CLI" ]]; then
    printf '%s\n' "$CODEX_BUNDLED_CLI"
    return 0
  fi
  die "Codex CLI not found. Install Codex or set CODEX_CLI=/path/to/codex."
}

quit_codex_app() {
  local attempt
  if ! codex_desktop_running; then
    return 0
  fi
  note "Quitting existing Codex app..."
  osascript -e 'tell application "Codex" to quit' > /dev/null 2>&1 || true
  for ((attempt = 0; attempt < CODEX_PROFILE_QUIT_ATTEMPTS; attempt++)); do
    if ! codex_desktop_running; then
      return 0
    fi
    sleep "$CODEX_PROFILE_QUIT_SLEEP"
  done
  die "Codex or its app-server is still running. Quit Codex with Cmd+Q, then retry."
}

command_app() {
  local profile="${1:-}"
  [[ -n "$profile" ]] || die "Usage: $PROGRAM app <profile> [workspace]"
  shift || true

  local workspace="${1:-$PWD}"
  local codex_home

  [[ -x "$CODEX_APP_BIN" ]] || die "Codex Desktop binary not found at $CODEX_APP_BIN"
  [[ -d "$workspace" ]] || die "Workspace directory not found: $workspace"

  codex_home="$(codex_home_for_profile "$profile")"
  ensure_home "$codex_home"
  quit_codex_app

  local log_dir="$codex_home/logs"
  local log_file="$log_dir/desktop.log"
  ensure_home "$log_dir"
  (umask 077 && : > "$log_file")
  chmod 600 "$log_file" 2> /dev/null || true

  note "Launching Codex Desktop with profile '$profile' (CODEX_HOME=$codex_home)"
  note "Log: $log_file"
  (umask 077 && nohup env CODEX_HOME="$codex_home" "$CODEX_APP_BIN" "$workspace" > "$log_file" 2>&1 &)
}

command_cli() {
  local profile="${1:-}"
  [[ -n "$profile" ]] || die "Usage: $PROGRAM cli <profile> [codex-args...]"
  shift || true

  local codex_home codex_cli
  codex_home="$(codex_home_for_profile "$profile")"
  ensure_home "$codex_home"
  codex_cli="$(find_codex_cli)"

  exec env CODEX_HOME="$codex_home" "$codex_cli" "$@"
}

default_browser_bundle_id() {
  defaults read com.apple.LaunchServices/com.apple.launchservices.secure LSHandlers 2>/dev/null \
    | grep -B1 'https' | grep 'LSHandlerRoleAll' | head -1 \
    | sed 's/.*= "//;s/";//' 2>/dev/null || echo ""
}

open_isolated_browser() {
  local url="$1"
  local tmpdir
  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/codex-login-XXXXXX")"

  local browser app_name
  browser="$(default_browser_bundle_id)"

  case "$browser" in
    com.google.chrome|com.google.chrome.canary) app_name="Google Chrome" ;;
    com.brave.browser*)                         app_name="Brave Browser" ;;
    company.thebrowser.browser)                 app_name="Arc" ;;
    com.microsoft.edgemac)                      app_name="Microsoft Edge" ;;
  esac

  if [[ -n "${app_name:-}" ]]; then
    note "Opening isolated $app_name session..."
    open -na "$app_name" --args --user-data-dir="$tmpdir" "$url"
  elif [[ "$browser" == org.mozilla.firefox ]]; then
    note "Opening isolated Firefox session..."
    /Applications/Firefox.app/Contents/MacOS/firefox -profile "$tmpdir" -no-remote "$url" &
  else
    note "Your browser does not support isolated sessions."
    note "Please log out of any existing OpenAI account before proceeding."
    open "$url"
  fi
}

command_login() {
  local profile="${1:-}"
  [[ -n "$profile" ]] || die "Usage: $PROGRAM login <profile> [codex-login-args...]"
  shift || true

  local codex_home codex_cli
  codex_home="$(codex_home_for_profile "$profile")"
  ensure_home "$codex_home"
  codex_cli="$(find_codex_cli)"

  local tmpout
  tmpout="$(mktemp "${TMPDIR:-/tmp}/codex-login-out-XXXXXX")"

  note "Starting login for profile '$profile'..."

  env CODEX_HOME="$codex_home" "$codex_cli" login "$@" > >(tee "$tmpout") 2>&1 &
  local pid=$!

  local url="" i
  for i in $(seq 1 30); do
    url="$(grep -oE 'https://[^ ]+' "$tmpout" 2>/dev/null | head -1 || true)"
    if [[ -n "$url" ]]; then
      break
    fi
    sleep 0.5
  done

  if [[ -n "$url" ]]; then
    open_isolated_browser "$url"
  else
    note "Could not extract login URL. Complete login in the browser that opened."
  fi

  wait "$pid"
  local exit_code=$?
  rm -f "$tmpout"
  return "$exit_code"
}

command_status_one() {
  local profile="$1"
  local codex_home codex_cli
  local status_output status_code

  codex_home="$(codex_home_for_profile "$profile")"

  if [[ ! -d "$codex_home" ]]; then
    printf '  %s (%s): Not initialized\n' "$profile" "$codex_home"
    return 0
  fi

  codex_cli="$(find_codex_cli)"

  printf '  %s (%s): ' "$profile" "$codex_home"

  set +e
  status_output="$(env CODEX_HOME="$codex_home" "$codex_cli" login status 2>&1)"
  status_code=$?
  set -e

  printf '%s\n' "$status_output"

  if [[ "$status_code" -eq 0 || "$status_output" == "Not logged in" ]]; then
    return 0
  fi
  return "$status_code"
}

command_status() {
  local status_code=0

  if [[ -n "${1:-}" ]]; then
    command_status_one "$1"
    return $?
  fi

  if [[ -d "$HOME/.codex" ]]; then
    command_status_one default || status_code=$?
  fi

  local dir profile
  for dir in "$HOME"/.codex-*; do
    [[ -d "$dir" ]] || continue
    profile="${dir##*/.codex-}"
    command_status_one "$profile" || status_code=$?
  done

  return "$status_code"
}

command_list() {
  local count=0

  if [[ -d "$HOME/.codex" ]]; then
    printf '  default -> %s/.codex\n' "$HOME"
    ((count++))
  fi

  local dir profile
  for dir in "$HOME"/.codex-*; do
    [[ -d "$dir" ]] || continue
    profile="${dir##*/.codex-}"
    printf '  %s -> %s\n' "$profile" "$dir"
    ((count++))
  done

  if [[ "$count" -eq 0 ]]; then
    note "No profiles found. Create one with: $PROGRAM login <profile>"
  fi
}

command_path() {
  local profile="${1:-}"
  [[ -n "$profile" ]] || die "Usage: $PROGRAM path <profile>"
  codex_home_for_profile "$profile"
}

command_doctor() {
  local codex_cli

  note "Codex profile doctor"
  note ""

  if [[ -x "$CODEX_APP_BIN" ]]; then
    note "Desktop: $CODEX_APP_BIN"
  else
    note "Desktop: missing ($CODEX_APP_BIN)"
  fi

  if codex_cli="$(find_codex_cli 2> /dev/null)"; then
    note "CLI: $codex_cli"
    "$codex_cli" --version || true
  else
    note "CLI: missing"
    note ""
    note "Status: skipped"
    return 0
  fi

  note ""
  note "Profiles:"
  command_list
  note ""
  note "Auth status:"
  command_status
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    app)    command_app "$@" ;;
    cli)    command_cli "$@" ;;
    login)  command_login "$@" ;;
    status) command_status "$@" ;;
    list)   command_list "$@" ;;
    path)   command_path "$@" ;;
    doctor) command_doctor "$@" ;;
    help | -h | --help) usage ;;
    *)      die "Unknown command '$command'. See '$PROGRAM help'." ;;
  esac
}

main "$@"
