#!/usr/bin/env bash
set -euo pipefail

PROGRAM="${0##*/}"
CODEX_APP="${CODEX_APP:-/Applications/Codex.app}"
CODEX_APP_BIN="${CODEX_APP_BIN:-$CODEX_APP/Contents/MacOS/Codex}"
CODEX_BUNDLED_CLI="${CODEX_BUNDLED_CLI:-$CODEX_APP/Contents/Resources/codex}"
CODEX_PROFILE_QUIT_ATTEMPTS="${CODEX_PROFILE_QUIT_ATTEMPTS:-30}"
CODEX_PROFILE_QUIT_SLEEP="${CODEX_PROFILE_QUIT_SLEEP:-0.5}"
OUTGOING_PROFILE=""

usage() {
  cat <<EOF
$PROGRAM - manage Codex auth profiles with a shared live ~/.codex runtime

Usage:
  $PROGRAM app <profile> [workspace]
  $PROGRAM login <profile> [codex-login-args...]
  $PROGRAM status [profile]
  $PROGRAM list
  $PROGRAM path <profile>
  $PROGRAM doctor

Examples:
  $PROGRAM login 1
  $PROGRAM app 1 ~/Dev/my-project
  $PROGRAM list
  $PROGRAM status

Environment:
  CODEX_APP       Override Codex.app path.
  CODEX_APP_BIN   Override Codex Desktop binary path.
  CODEX_CLI       Override Codex CLI binary path.
EOF
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

validate_profile() {
  local profile="$1"
  if ! is_valid_profile "$profile"; then
    die "Invalid profile '$profile'. Use letters, numbers, dots, dashes, or underscores."
  fi
}

is_valid_profile() {
  local profile="$1"
  [[ "$profile" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

switcher_home() {
  printf '%s/.codex-switcher\n' "$HOME"
}

live_codex_home() {
  printf '%s/.codex\n' "$HOME"
}

live_auth_path() {
  printf '%s/auth.json\n' "$(live_codex_home)"
}

codex_global_state_path() {
  printf '%s/.codex-global-state.json\n' "$(live_codex_home)"
}

config_path() {
  printf '%s/config.json\n' "$(switcher_home)"
}

auth_store_dir() {
  printf '%s/auth\n' "$(switcher_home)"
}

auth_store_path() {
  local profile="$1"
  validate_profile "$profile"
  printf '%s/%s.json\n' "$(auth_store_dir)" "$profile"
}

make_temp_home() {
  local profile="$1"
  validate_profile "$profile"
  local tmp_root
  tmp_root="$(switcher_home)/tmp"
  mkdir -p "$tmp_root" || die "Cannot create directory: $tmp_root"
  chmod 700 "$tmp_root" || true
  mktemp -d "$tmp_root/${profile}-XXXXXX"
}

ensure_private_dir() {
  local dir="$1"
  mkdir -p "$dir" || die "Cannot create directory: $dir"
  [[ -d "$dir" ]] || die "Not a directory: $dir"
  chmod 700 "$dir" || die "Cannot set private permissions on: $dir"
}

ensure_auth_store() {
  ensure_private_dir "$(switcher_home)"
  ensure_private_dir "$(auth_store_dir)"
  migrate_legacy_profiles
}

atomic_copy_file() {
  local source="$1"
  local destination="$2"
  [[ -f "$source" ]] || die "File not found: $source"

  local destination_dir temp_file
  destination_dir="$(dirname "$destination")"
  ensure_private_dir "$destination_dir"
  temp_file="$(mktemp "$destination_dir/.${PROGRAM}.XXXXXX")"

  cp "$source" "$temp_file" || { rm -f "$temp_file"; die "Failed to copy $source"; }
  chmod 600 "$temp_file" 2>/dev/null || true
  mv -f "$temp_file" "$destination" || { rm -f "$temp_file"; die "Failed to replace $destination"; }
}

# SYNC: CodexProfileSwitcher.swift authIdentity() must produce identical fingerprints
# Shared Python fingerprint module — used by auth_fingerprint() and find_matching_profiles()
_FINGERPRINT_PY='
import base64, hashlib, json, pathlib, sys

STABLE_ID_TOKEN_CLAIMS = (
    "sub",
    "email",
    "https://api.openai.com/auth",
    "https://api.openai.com/account_id",
    "https://api.openai.com/user_id",
    "https://api.openai.com/organization_id",
)

def string_value(data, *keys):
    for key in keys:
        value = data.get(key)
        if isinstance(value, str) and value:
            return value
    return None

def decode_jwt_payload(token):
    parts = token.split(".")
    if len(parts) < 2:
        return None
    payload = parts[1]
    payload += "=" * ((4 - len(payload) % 4) % 4)
    try:
        decoded = base64.urlsafe_b64decode(payload.encode())
        data = json.loads(decoded)
    except Exception:
        return None
    return data if isinstance(data, dict) else None

def stable_claims(id_token):
    payload = decode_jwt_payload(id_token)
    if not payload:
        return {}
    claims = {}
    for key in STABLE_ID_TOKEN_CLAIMS:
        value = payload.get(key)
        if isinstance(value, str) and value:
            claims[key] = value
    return claims

def fingerprint(path):
    try:
        data = json.loads(path.read_text())
    except Exception:
        return None
    api_key = data.get("OPENAI_API_KEY")
    if isinstance(api_key, str) and api_key.strip():
        identity = {"kind": "api-key", "keyHash": hashlib.sha256(api_key.encode()).hexdigest()}
    else:
        tokens = data.get("tokens")
        if not isinstance(tokens, dict):
            return None
        account_id = string_value(tokens, "account_id", "accountId")
        id_token = string_value(tokens, "id_token", "idToken")
        claims = stable_claims(id_token) if id_token else {}
        if not claims:
            return None
        identity = {"kind": "oauth", "idTokenClaims": claims}
        if account_id:
            identity["accountId"] = account_id
    return hashlib.sha256(json.dumps(identity, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
'

auth_fingerprint() {
  local auth_path="$1"
  [[ -f "$auth_path" ]] || return 1
  python3 -c "${_FINGERPRINT_PY}
fp = fingerprint(pathlib.Path(sys.argv[1]))
if not fp:
    sys.exit(1)
print(fp)
" "$auth_path"
}

read_account_id() {
  local auth_path="$1"
  [[ -f "$auth_path" ]] || return 1
  python3 - "$auth_path" <<'PY'
import json, pathlib, sys
path = pathlib.Path(sys.argv[1])
try:
    data = json.loads(path.read_text())
except Exception:
    sys.exit(1)
tokens = data.get("tokens") or {}
account_id = tokens.get("account_id") or tokens.get("accountId")
if account_id:
    print(account_id)
    sys.exit(0)
api_key = data.get("OPENAI_API_KEY")
if api_key:
    print("api-key")
    sys.exit(0)
sys.exit(1)
PY
}

save_active_profile() {
  local profile="$1"
  validate_profile "$profile"
  ensure_private_dir "$(switcher_home)"
  python3 - "$(config_path)" "$profile" <<'PY'
import json, os, pathlib, sys, tempfile
path = pathlib.Path(sys.argv[1])
profile = sys.argv[2]
data = {"profiles": [], "activeProfile": profile}
if path.exists():
    try:
        data = json.loads(path.read_text())
    except Exception:
        data = {"profiles": [], "activeProfile": profile}
data["activeProfile"] = profile
content = (json.dumps(data, indent=2, sort_keys=True) + "\n").encode()
fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".config-", suffix=".json")
closed = False
try:
    os.write(fd, content)
    os.close(fd)
    closed = True
    os.chmod(tmp, 0o600)
    os.rename(tmp, str(path))
except BaseException:
    if not closed:
        os.close(fd)
    os.unlink(tmp)
    raise
PY
}

config_active_profile() {
  local path
  path="$(config_path)"
  [[ -f "$path" ]] || return 1
  python3 - "$path" <<'PY'
import json, pathlib, sys
path = pathlib.Path(sys.argv[1])
try:
    data = json.loads(path.read_text())
except Exception:
    sys.exit(1)
value = data.get("activeProfile")
if isinstance(value, str) and value:
    print(value)
else:
    sys.exit(1)
PY
}

snapshot_auth_to_store() {
  local profile="$1"
  local auth_path="$2"
  atomic_copy_file "$auth_path" "$(auth_store_path "$profile")"
}

migrate_legacy_profiles() {
  local legacy_dir profile legacy_auth destination
  for legacy_dir in "$HOME"/.codex-*; do
    [[ -d "$legacy_dir" ]] || continue
    [[ "${legacy_dir##*/}" != ".codex-switcher" ]] || continue
    profile="${legacy_dir##*/.codex-}"
    is_valid_profile "$profile" || continue

    legacy_auth="$legacy_dir/auth.json"
    [[ -f "$legacy_auth" ]] || continue

    destination="$(auth_store_path "$profile")"
    [[ ! -f "$destination" ]] || continue

    atomic_copy_file "$legacy_auth" "$destination"
    note "Migrated legacy auth for profile '$profile' to $destination"
  done

  return 0
}

snapshot_live_auth_to_store() {
  local profile="$1"
  snapshot_auth_to_store "$profile" "$(live_auth_path)"
}

restore_live_auth_from_store() {
  local profile="$1"
  local source
  source="$(auth_store_path "$profile")"
  [[ -f "$source" ]] || die "No saved auth for profile '$profile'. Run '$PROGRAM login $profile' first."
  ensure_private_dir "$(live_codex_home)"
  atomic_copy_file "$source" "$(live_auth_path)"
}

resolve_workspace_from_global_state() {
  local state_path
  state_path="$(codex_global_state_path)"
  [[ -f "$state_path" ]] || return 1
  python3 - "$state_path" <<'PY'
import json, pathlib, sys

path = pathlib.Path(sys.argv[1])
try:
    data = json.loads(path.read_text())
except Exception:
    sys.exit(1)

for key in ("active-workspace-roots", "electron-saved-workspace-roots"):
    values = data.get(key)
    if not isinstance(values, list):
        continue
    for value in values:
        if not isinstance(value, str) or not value:
            continue
        candidate = pathlib.Path(value).expanduser()
        if candidate.is_dir():
            print(str(candidate.resolve()))
            sys.exit(0)

sys.exit(1)
PY
}

saved_profiles() {
  local store
  store="$(auth_store_dir)"
  [[ -d "$store" ]] || return 0
  find "$store" -maxdepth 1 -type f -name '*.json' -print | sort | while read -r path; do
    local profile
    profile="$(basename "$path" .json)"
    is_valid_profile "$profile" || continue
    printf '%s\n' "$profile"
  done
}

find_matching_profiles() {
  local live_auth="$1"
  local store_dir="$2"
  python3 -c "${_FINGERPRINT_PY}
live_path = pathlib.Path(sys.argv[1])
store_dir = pathlib.Path(sys.argv[2])
live_fp = fingerprint(live_path)
if not live_fp:
    sys.exit(1)
for f in sorted(store_dir.glob('*.json')):
    name = f.stem
    if not name or not name[0].isalnum():
        continue
    if fingerprint(f) == live_fp:
        print(name)
" "$live_auth" "$store_dir"
}

determine_outgoing_profile() {
  OUTGOING_PROFILE=""
  local live_auth store
  live_auth="$(live_auth_path)"
  store="$(auth_store_dir)"
  [[ -f "$live_auth" ]] || return 1
  [[ -d "$store" ]] || return 1

  local matches=() match_profile
  while read -r match_profile; do
    [[ -n "$match_profile" ]] || continue
    matches+=("$match_profile")
  done < <(find_matching_profiles "$live_auth" "$store")

  if [[ "${#matches[@]}" -eq 1 ]]; then
    OUTGOING_PROFILE="${matches[0]}"
    return 0
  fi

  if [[ "${#matches[@]}" -gt 1 ]]; then
    local fallback match
    fallback="$(config_active_profile 2>/dev/null || true)"
    for match in "${matches[@]}"; do
      if [[ "$match" == "$fallback" ]]; then
        OUTGOING_PROFILE="$fallback"
        return 0
      fi
    done
    die "Live auth matches multiple saved profiles and config.activeProfile is not one of them."
  fi

  return 1
}

codex_desktop_running() {
  pgrep -x Codex > /dev/null 2>&1 && return 0
  pgrep -f "$CODEX_BUNDLED_CLI app-server" > /dev/null 2>&1 && return 0
  return 1
}

find_codex_cli() {
  if [[ -n "${CODEX_CLI:-}" ]]; then
    [[ -x "$CODEX_CLI" ]] || die "CODEX_CLI is set but not executable: $CODEX_CLI"
    printf '%s\n' "$CODEX_CLI"
    return 0
  fi
  if command -v codex > /dev/null 2>&1; then
    command -v codex
    return 0
  fi
  if [[ -x "$CODEX_BUNDLED_CLI" ]]; then
    printf '%s\n' "$CODEX_BUNDLED_CLI"
    return 0
  fi
  die "Codex CLI not found. Install Codex or set CODEX_CLI=/path/to/codex."
}

quit_codex_app() {
  local attempt
  if ! codex_desktop_running; then
    return 0
  fi
  note "Quitting existing Codex app..."
  osascript -e 'tell application "Codex" to quit' > /dev/null 2>&1 || true
  for ((attempt = 0; attempt < CODEX_PROFILE_QUIT_ATTEMPTS; attempt++)); do
    if ! codex_desktop_running; then
      return 0
    fi
    sleep "$CODEX_PROFILE_QUIT_SLEEP"
  done
  die "Codex or its app-server is still running. Quit Codex with Cmd+Q, then retry."
}

print_status() {
  local profile="$1"
  local auth_path
  auth_path="$(auth_store_path "$profile")"
  if [[ ! -f "$auth_path" ]]; then
    printf '  %s: Not set up\n' "$profile"
    return 0
  fi

  local account_id
  account_id="$(read_account_id "$auth_path" 2>/dev/null || true)"
  if [[ -n "$account_id" ]]; then
    if [[ "$account_id" == "api-key" ]]; then
      printf '  %s: Saved API key auth\n' "$profile"
    else
      printf '  %s: Saved account %s\n' "$profile" "$account_id"
    fi
  else
    printf '  %s: Saved auth (account unknown)\n' "$profile"
  fi
}

command_app() {
  local profile="${1:-}"
  [[ -n "$profile" ]] || die "Usage: $PROGRAM app <profile> [workspace]"
  validate_profile "$profile"
  shift || true

  local requested_workspace="${1:-}"
  local workspace=""
  [[ -x "$CODEX_APP_BIN" ]] || die "Codex Desktop binary not found at $CODEX_APP_BIN"
  if [[ -n "$requested_workspace" ]]; then
    [[ -d "$requested_workspace" ]] || die "Workspace directory not found: $requested_workspace"
    workspace="$requested_workspace"
  else
    workspace="$(resolve_workspace_from_global_state 2> /dev/null || true)"
  fi

  ensure_auth_store
  ensure_private_dir "$(live_codex_home)"
  [[ -f "$(auth_store_path "$profile")" ]] || die "No saved auth for profile '$profile'. Run '$PROGRAM login $profile' first."

  local outgoing_profile=""
  if [[ -f "$(live_auth_path)" ]]; then
    if determine_outgoing_profile; then
      outgoing_profile="$OUTGOING_PROFILE"
      if [[ "$outgoing_profile" == "$profile" ]] && codex_desktop_running; then
        note "Profile '$profile' is already active."
        return 0
      fi
    else
      die "Live auth does not match any saved profile. Refusing to overwrite ~/.codex/auth.json until the current account is saved in the switcher."
    fi
  fi

  quit_codex_app

  if [[ -n "$outgoing_profile" ]]; then
    snapshot_live_auth_to_store "$outgoing_profile"
  fi

  restore_live_auth_from_store "$profile"
  save_active_profile "$profile"

  local log_dir log_file
  log_dir="$(live_codex_home)/logs"
  log_file="$log_dir/desktop.log"
  ensure_private_dir "$log_dir"
  (umask 077 && : > "$log_file")
  chmod 600 "$log_file" 2> /dev/null || true

  note "Launching Codex Desktop with profile '$profile'"
  note "Log: $log_file"
  if [[ -n "$workspace" ]]; then
    note "Workspace: $workspace"
    (umask 077 && nohup "$CODEX_APP_BIN" "$workspace" > "$log_file" 2>&1 &)
  else
    note "Workspace: <default>"
    (umask 077 && nohup "$CODEX_APP_BIN" > "$log_file" 2>&1 &)
  fi
}

command_login() {
  local profile="${1:-}"
  [[ -n "$profile" ]] || die "Usage: $PROGRAM login <profile> [codex-login-args...]"
  validate_profile "$profile"
  shift || true

  ensure_auth_store

  local temp_home codex_cli login_status
  temp_home="$(make_temp_home "$profile")"
  trap 'rm -rf "$temp_home"' EXIT
  codex_cli="$(find_codex_cli)"

  note "Starting isolated login for profile '$profile'..."
  set +e
  env CODEX_HOME="$temp_home" "$codex_cli" login "$@"
  login_status=$?
  set -e

  if [[ "$login_status" -ne 0 ]]; then
    rm -rf "$temp_home"
    trap - EXIT
    return "$login_status"
  fi

  [[ -f "$temp_home/auth.json" ]] || { rm -rf "$temp_home"; trap - EXIT; die "Login completed but no auth.json was created"; }
  snapshot_auth_to_store "$profile" "$temp_home/auth.json"
  rm -rf "$temp_home"
  trap - EXIT
  note "Saved auth for profile '$profile' to $(auth_store_path "$profile")"
}

command_status() {
  ensure_auth_store

  if [[ -n "${1:-}" ]]; then
    validate_profile "$1"
    print_status "$1"
    return 0
  fi

  local any=0 profile
  while read -r profile; do
    [[ -n "$profile" ]] || continue
    any=1
    print_status "$profile"
  done < <(saved_profiles)

  if [[ "$any" -eq 0 ]]; then
    note "No saved auth profiles. Create one with: $PROGRAM login <profile>"
  fi
}

command_list() {
  ensure_auth_store

  local any=0 profile
  while read -r profile; do
    [[ -n "$profile" ]] || continue
    any=1
    printf '  %s -> %s\n' "$profile" "$(auth_store_path "$profile")"
  done < <(saved_profiles)

  if [[ "$any" -eq 0 ]]; then
    note "No saved auth profiles. Create one with: $PROGRAM login <profile>"
  fi
}

command_path() {
  local profile="${1:-}"
  [[ -n "$profile" ]] || die "Usage: $PROGRAM path <profile>"
  printf '%s\n' "$(auth_store_path "$profile")"
}

command_doctor() {
  local codex_cli

  note "Codex profile doctor"
  note ""

  if [[ -x "$CODEX_APP_BIN" ]]; then
    note "Desktop: $CODEX_APP_BIN"
  else
    note "Desktop: missing ($CODEX_APP_BIN)"
  fi

  if codex_cli="$(find_codex_cli 2> /dev/null)"; then
    note "CLI: $codex_cli"
    "$codex_cli" --version || true
  else
    note "CLI: missing"
  fi

  note ""
  note "Saved profiles:"
  command_list
  note ""
  note "Saved auth status (vault metadata only):"
  command_status
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    app)    command_app "$@" ;;
    login)  command_login "$@" ;;
    status) command_status "$@" ;;
    list)   command_list "$@" ;;
    path)   command_path "$@" ;;
    doctor) command_doctor "$@" ;;
    help | -h | --help) usage ;;
    *)      die "Unknown command '$command'. See '$PROGRAM help'." ;;
  esac
}

main "$@"
